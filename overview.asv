function run_nlms(activity_mat_file) 
A = load(activity_mat_file); 
data = A.data; 

fprintf('Loaded %d subjects from %s\n', length(data), activity_mat_file); L = 8; mu = 0.01; % step size delta = 1e-3; % regularization %% === STORE FILTERED SIGNALS === filtered_data = data; % will store NLMS outputs inside this %% === PROCESS EACH SUBJECT === for s = 1:length(data) fprintf('Processing subject %d of %d...\n', s, length(data)); D = data(s); % subject struct inside this activity % Check if signals exist if ~isfield(D, 'ppg') || ~isfield(D, 'acc_ppg_site') warning('Missing signals for subject %d. Skipping...', s); continue; end %% --- Extract PPG & ACC --- ppg = D.ppg.v(:); fs_ppg = D.ppg.fs; acc_mag = D.acc_ppg_site.v(:); % already magnitude fs_acc = D.acc_ppg_site.fs; %% --- Convert ACC magnitude back to 3-axis reference? --- % Since you only have magnitude here, the reference becomes single-channel. % NLMS still works, just less ideally than 3-axis raw ACC. R = acc_mag(:); %% --- If ACC is lower sampling rate, resample to match PPG --- if fs_acc ~= fs_ppg [p, q] = rat(fs_ppg / fs_acc); R = resample(R, p, q); end % Match lengths N = min(length(ppg), length(R)); ppg = ppg(1:N); R = R(1:N); %% === Run NLMS adaptive filter === [y_hat, ppg_filt, W] = nlms_filter(ppg, R, mu, L, delta); % Store filtered signal filtered_data(s).ppg_filt = ppg_filt; end %% === VISUALIZATION: RAW VS FILTERED PPG FOR ALL SUBJECTS === dur = 8; % seconds to display fprintf('\nPlotting filtered output for first %d seconds...\n', dur); figure('Name', ['PPG NLMS Comparison - ' activity_mat_file], ... 'Position',[100 100 1200 700]); for s = 1:min(6, length(data)) % show first 6 subjects D = data(s); ppg = D.ppg.v(:); fs_ppg = D.ppg.fs; ppg_filt = filtered_data(s).ppg_filt; % time N = min(length(ppg), length(ppg_filt)); t = (0:N-1)/fs_ppg; idx = t <= dur; subplot(3,2,s); plot(t(idx), ppg(idx), 'r'); hold on; plot(t(idx), ppg_filt(idx), 'b'); title(sprintf('Subject %d', s)); xlabel('Time (s)'); ylabel('PPG'); legend('Raw','Filtered'); grid on; end sgtitle(['NLMS Filtering for Activity: ', strrep(activity_mat_file,'_','\_')]); %% === OPTIONAL: SAVE FILTERED ACTIVITY FILE === [folder, name, ~] = fileparts(activity_mat_file); save(fullfile(folder, [name '_filtered.mat']), 'filtered_data'); fprintf('\nSaved filtered activity file: %s_filtered.mat\n', name); end