function relabel_data()
% Relabel your data with proper artifact detection

clear; clc; close all;

% Get all windowed files
windowed_files = dir('windowed_data/*_windowed.mat');

fprintf('Relabeling %d windowed files...\n', length(windowed_files));

% Threshold for ACC motion (this can be adjusted later)
motion_threshold = 100;   % Initial threshold (adjust based on your data)

for file_idx = 1:length(windowed_files)
    file_path = fullfile(windowed_files(file_idx).folder, windowed_files(file_idx).name);
    fprintf('\nProcessing: %s\n', windowed_files(file_idx).name);
    
    % Load windowed data
    A = load(file_path);
    windowed_data = A.windowed_data;
    
    labeled_data = struct();
    
    % === Check ACC standard deviation distribution across subjects ===
    acc_std_values = [];
    
    % Loop through subjects to collect acc_std values
    for s = 1:length(windowed_data)
        ppg_windows = windowed_data(s).ppg_windows;
        acc_windows = windowed_data(s).acc_windows;
        
        % Calculate standard deviation of ACC for each window
        acc_std_values = [acc_std_values; std(acc_windows, [], 2)];
    end
    
    % Visualize ACC standard deviation distribution
    figure;
    histogram(acc_std_values, 50);
    title('Distribution of ACC Std (Motion Features)');
    xlabel('ACC Standard Deviation');
    ylabel('Frequency');
    grid on;
    
    % Ask for user threshold adjustment
    disp(['Threshold value used: ' num2str(motion_threshold)]);
    disp('Use the histogram to decide if the threshold needs adjustment.');
    pause;  % Allow user to manually check the histogram

    for s = 1:length(windowed_data)
        fprintf('  Subject %d: ', s);
        
        ppg_windows = windowed_data(s).ppg_windows;
        acc_windows = windowed_data(s).acc_windows;
        
        num_windows = size(ppg_windows, 1);
        labels = zeros(num_windows, 1); % Start with all clean
        
        % Label based on motion artifacts
        for w = 1:num_windows
            ppg_win = ppg_windows(w, :);
            acc_win = acc_windows(w, :);
            
            % Calculate artifact indicators
            acc_std = std(acc_win);
            ppg_std = std(ppg_win);
            correlation = corr(ppg_win(:), acc_win(:));
            
            % Simple rule-based labeling (you can adjust these thresholds)
            if acc_std > motion_threshold || ppg_std > 150 || abs(correlation) > 0.1
                labels(w) = 1; % Artifact
            else
                labels(w) = 0; % Clean
            end
            
            % --- Visualize windows with high motion and their labels ---
            if acc_std > motion_threshold  % If high motion, visualize
                % Plot PPG and ACC for this window
                figure;
                subplot(2,1,1);
                plot(ppg_win);
                title('PPG Window (High Motion)');
                xlabel('Samples');
                ylabel('Amplitude');
                
                subplot(2,1,2);
                plot(acc_win);
                title('ACC Magnitude (High Motion)');
                xlabel('Samples');
                ylabel('Magnitude');
                
                % Show the label (artifact = 1)
                fprintf('Window %d: Label = %d (Artifact)\n', w, labels(w));
                pause; % Pause to view the plots
            end
        end
        
        labeled_data(s).ppg_windows = ppg_windows;
        labeled_data(s).acc_windows = acc_windows;
        labeled_data(s).labels = labels;
        labeled_data(s).win_times = windowed_data(s).win_times;
        
        fprintf('%d windows (%d clean, %d artifact)\n', ...
            num_windows, sum(labels==0), sum(labels==1));
    end
    
    % Save relabeled data
    [~, name, ~] = fileparts(windowed_files(file_idx).name);
    name = erase(name, "_windowed");
    output_file = fullfile('labeled_data', sprintf('%s_labeled.mat', name));
    
    if ~exist('labeled_data', 'dir')
        mkdir('labeled_data');
    end
    
    save(output_file, 'labeled_data');
    fprintf('Saved: %s\n', output_file);
end

fprintf('\n=== RELABELING COMPLETE ===\n');
end
